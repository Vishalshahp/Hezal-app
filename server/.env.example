# Application Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local fallback)
# Example Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hezal_market?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hezal_market

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# JWT Authentication
# In production, generate a secure random 64-char key: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials (Used by npm run seed:admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@hezalmarket.com
ADMIN_PASSWORD=ChangeMeAdmin123!
