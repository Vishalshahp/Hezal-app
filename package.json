{
  "name": "hezal-market",
  "version": "1.0.0",
  "description": "Hezal Market - Local Vendor Discovery Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --prefix client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "lint:server": "npm --prefix server run lint",
    "lint:client": "npm --prefix client run lint",
    "test": "npm run test:server && npm run test:client",
    "lint": "npm run lint:server && npm run lint:client",
    "seed:admin": "npm --prefix server run seed:admin",
    "seed:categories": "npm --prefix server run seed:categories",
    "seed:vendors": "npm --prefix server run seed:vendors"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.5.0"
  },
  "keywords": [
    "mern",
    "local-vendor-discovery",
    "street-vendors",
    "geospatial"
  ],
  "author": "Hezal Market Team",
  "license": "ISC"
}
