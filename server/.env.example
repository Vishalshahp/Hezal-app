# Application Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local fallback)
# Example Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hezal_market?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hezal_market

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
