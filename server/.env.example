# Application Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local fallback)
# Example Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hezal_market?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hezal_market

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# JWT Authentication
# In production, generate a secure random 64-char key: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials (Used by npm run seed:admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@hezalmarket.com
ADMIN_PASSWORD=ChangeMeAdmin123!

# Cloudinary Media Storage (Optional for local dev, uses local storage fallback if empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMS OTP Provider Configuration (Optional for development; uses smart simulator if empty)
# Provider choices: auto | fast2sms | twilio | simulator
SMS_PROVIDER=auto

# Fast2SMS (Indian Gateway - Free test wallet on signup, no DLT required for OTP route)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio SMS (International Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
