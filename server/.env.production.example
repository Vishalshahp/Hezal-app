# ==========================================
# Hezal Market Server — Production Template
# ==========================================

# Application Runtime Environment
NODE_ENV=production
PORT=5000

# MongoDB Production Connection String (e.g. MongoDB Atlas Cluster)
# Example: mongodb+srv://hezal_user:<password>@cluster0.mongodb.net/hezal_market?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hezal_market?retryWrites=true&w=majority

# Allowed Frontend Origins (Comma-separated for multi-domain support)
# Example: https://hezalmarket.com,https://www.hezalmarket.com,https://hezalmarket.vercel.app
FRONTEND_URL=https://hezalmarket.com

# Cryptographic JSON Web Token Configuration (Generate a strong 64-char random hex string)
# Command to generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_character_secret
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials (Used by npm run seed:admin)
ADMIN_NAME=Super Administrator
ADMIN_EMAIL=admin@hezalmarket.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Cloudinary Production Credentials (For vendor stall & product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Cookie Security Settings
# Use 'none' if frontend and backend are hosted on separate domains (e.g. Vercel + Render)
# Use 'lax' if hosted on the same root domain or behind a reverse proxy
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
